FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/region2";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 32;

boundaryField
{
    inlet2
    {
        type            fixedValue;
        value           uniform 32;
    }

    outlet2
    {
        type            zeroGradient;
    }

    region2_to_pipeWall
    {
        type            omegaWallFunction;
        value           uniform 32;
    }

    outerWall
    {
        type            omegaWallFunction;
        value           uniform 32;
    }
}
