{
    inlet2
    {
        type            calculated;
        value           uniform 101325;
    }

    outlet2
    {
        type            calculated;
        value           uniform 101325;
    }

    outerWall
    {
        type            calculated;
        value           uniform 101325;
    }

    region2_to_pipeWall
    {
        type            calculated;
        value           uniform 101325;
    }
}

