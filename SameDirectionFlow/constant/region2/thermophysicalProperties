FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/region2";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    // Water at 300 K

    specie
    {
        molWeight       18.015;
    }

    equationOfState
    {
        rho             996.56;
    }

    thermodynamics
    {
        Cp              4180.75;
        Hf              0;
    }

    transport
    {
        mu              8.537e-4;
        Pr              5.86;
    }
}

